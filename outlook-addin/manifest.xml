<?xml version="1.0" encoding="UTF-8"?>
<!-- Togavsu Email add-in. The module fills in {{.Base}} (the firm's public module
     address) and {{.ID}} when the admin downloads this file from the Mail accounts tab. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>{{.ID}}</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Chariton Media</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Togavsu Email"/>
  <Description DefaultValue="File mail to Togavsu matters and find the matter for a message."/>
  <IconUrl DefaultValue="{{.Base}}/outlook-addin/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="{{.Base}}/outlook-addin/icon-80.png"/>
  <SupportUrl DefaultValue="{{.Base}}/outlook-addin/taskpane.html"/>
  <AppDomains>
    <AppDomain>{{.Origin}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.14"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{.Base}}/outlook-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.14">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="togavsuRead">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="togavsuReadOpen">
                    <Label resid="Open.Label"/>
                    <Supertip><Title resid="Open.Label"/><Description resid="Open.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="togavsuCompose">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="togavsuComposeOpen">
                    <Label resid="FileSent.Label"/>
                    <Supertip><Title resid="FileSent.Label"/><Description resid="FileSent.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{{.Base}}/outlook-addin/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{{.Base}}/outlook-addin/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{{.Base}}/outlook-addin/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="{{.Base}}/outlook-addin/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="{{.Base}}/outlook-addin/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Togavsu"/>
          <bt:String id="Open.Label" DefaultValue="File to matter"/>
          <bt:String id="FileSent.Label" DefaultValue="File sent copy to matter"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Open.Tip" DefaultValue="Find this message's matter in Togavsu and file it there."/>
          <bt:String id="FileSent.Tip" DefaultValue="File the copy you send to a Togavsu matter."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
